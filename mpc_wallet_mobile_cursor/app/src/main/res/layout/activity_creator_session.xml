<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title_creator_session"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sessionStateText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/status_bootstrap" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/incrementJoinButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/action_mark_party_joined" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/completeCreationButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:enabled="false"
        android:text="@string/action_complete_wallet_creation" />
</LinearLayout>
